// ═══ Spell render (generic) ═════════════════════════════════════════════════
// Returns vec4(color, alpha). font=0 galapogo, font=1 zone99
vec4 renderSpell(vec2 fragCoord, vec2 res, float t, int font){
    vec2 lab=fragCoord/res-.5;
    lab.x*=res.x/res.y;

    float lineH,fontBase,adv,drawDur=5.,pauseDur=2.5;
    int N;
    if(font==0){lineH=34.128;fontBase=8.256;adv=342.672;N=18;}
    else{lineH=53.7422;fontBase=8.2969;adv=305.0625;N=8;}

    float pix=lineH/.12;
    vec2 fuv=vec2(lab.x*pix+adv*.5,lab.y*pix+(font==0?-7.92:-14.7305));

    int codes1[18]=int[](79,114,98,108,105,118,105,117,115,32,112,114,101,115,101,110,116,115);
    int codes2[8]=int[](69,109,105,110,97,110,99,101);

    float period=drawDur+pauseDur;
    float lt=min(t,period);
    float dt=drawDur/float(N);

    vec3 col=vec3(0);float al=0.,cx=0.;

    for(int i=0;i<18;i++){
        if(i>=N)break;
        int c=font==0?codes1[i]:codes2[i];
        vec4 gr=font==0?gGlyphRect(c):zGlyphRect(c);
        vec4 mt=font==0?gGlyphMeta(c):zGlyphMeta(c);
        float el=lt-float(i)*dt;

        if(c!=32&&el>0.){
            vec2 bl=vec2(cx+mt.x,fontBase-mt.y-mt.w);
            vec2 sz=vec2(gr.z,mt.w);
            vec2 lc=(fuv-bl)/sz;

            if(all(greaterThanEqual(lc,vec2(0)))&&all(lessThanEqual(lc,vec2(1)))){
                vec2 gp=gr.xy+lc*gr.zw;
                float d=font==0?gSDF(gp):zSDF(gp);
                float fw=max(fwidth(d),.001);
                vec2 ctr=gr.xy+gr.zw*.5;
                float op=atan(gp.y-ctr.y,gp.x-ctr.x)/(2.*acos(-1.))+.5;
                float prog=clamp(el,0.,.5)*2.;
                float revealed=step(op,prog);
                float flashFade=smoothstep(.55,.42,el);
                float flash=smoothstep(.06,0.,abs(op-prog))*smoothstep(1.8,0.,abs(d))*flashFade;
                float gProg=clamp(el-.15,0.,.5);
                float glowInLc=4./max(sz.x,sz.y);
                vec2 edgeDist=min(lc,1.-lc);
                float bboxFade=smoothstep(0.,glowInLc,min(edgeDist.x,edgeDist.y));
                float glowA=smoothstep(4.,0.,d)*step(op,gProg)*.28*bboxFade;
                float fillA=smoothstep(fw,-fw,d)*revealed;
                vec3 base=vec3(.41,.58,.74);
                vec3 cc=mix(base,vec3(1),flash);
                float tot=clamp(fillA+flash+glowA,0.,1.);
                float blend=tot*(1.-al);
                col+=cc*blend;
                al=clamp(al+blend,0.,1.);
            }
        }
        cx+=mt.z;
    }
    col=tintHueShift(col,t*.1);
    return vec4(col,al);
}

// Cosine palette for VooDoo effect
vec3 _palette(float t){
    return vec3(.5)+vec3(.5)*cos(6.28318*(vec3(1)*t+vec3(0)));
}

// VooDoo fractal render for "Eminance" — Zone99 font
vec4 renderVoodoo(vec2 fragCoord, vec2 res){
    vec2 lab=fragCoord/res-.5;
    lab.x*=res.x/res.y;
    float pix=53.7422/.12;
    vec2 fuv=vec2(lab.x*pix+305.0625*.5, lab.y*pix-14.7305);

    int codes[8]=int[](69,109,105,110,97,110,99,101);
    vec3 col=vec3(0);float al=0.,cx2=0.;

    for(int i=0;i<8;i++){
        int c=codes[i];
        vec4 gr=zGlyphRect(c);
        vec4 mt=zGlyphMeta(c);
        if(c!=32){
            vec2 bl=vec2((cx2+mt.x)*2.2-180.,8.2969-mt.y-mt.w);
            vec2 sz=vec2(gr.z,mt.w)*2.2;
            vec2 lc=(fuv-bl)/sz;
            if(all(greaterThanEqual(lc,vec2(0)))&&all(lessThanEqual(lc,vec2(1)))){
                vec2 gp=gr.xy+lc*gr.zw;
                float d=zSDF(gp);
                float fw=max(fwidth(d),.001);
                float sdfFont=smoothstep(fw*6.,-fw*6.,d);
                float edgeDist=.743-sdfFont;
                vec2 ctr=gr.xy+gr.zw*.5;
                float op=atan(gp.y-ctr.y,gp.x-ctr.x)/(2.*acos(-1.))+.5;
                op*=edgeDist;
                vec2 uv=vec2(op,sdfFont*.4-.9);
                vec2 Cu=uv;
                vec3 Cv=vec3(0);
                for(float Cw=0.;Cw<4.;Cw++){
                    uv=fract(uv*1.5)-.5;
                    float r2=length(uv)*exp(-length(Cu));
                    vec3 Cx=_palette(length(Cu)+Cw*.4+iTime*.4);
                    r2=sin(r2*8.+iTime+fragCoord.x/100.)/8.;
                    r2=abs(r2);
                    r2=pow(.01/max(r2,.008),1.2);
                    Cv+=Cx*min(r2,4.);
                }
                float bboxFade=smoothstep(0.,.04,min(min(lc.x,1.-lc.x),min(lc.y,1.-lc.y)));
                float alpha=min(sdfFont,min(1.,Cv.r+Cv.g+Cv.b));
                float blend=alpha*(1.-al)*bboxFade;
                col+=Cv*blend;
                al=clamp(al+blend,0.,1.);
            }
        }
        cx2+=mt.z;
    }
    return vec4(col,al);
}

// ═══ Visualizer noise / FFT ═════════════════════════════════════════════════
float tri2(float x){return abs(fract(x)-.5);}
vec3 tri32(vec3 p){return abs(fract(p.zzy+abs(fract(p.yxx)-.5))-.5);}
float triNoise3D(vec3 p,float spd){float z=1.4,rz=0.;vec3 bp=p;for(float i=0.;i<=3.;i++){vec3 dg=tri32(bp*2.);p+=dg+iTime*.3*spd;bp*=1.8;z*=1.5;p*=1.2;rz+=tri2(p.z+tri2(p.x+tri2(p.y)))/z;bp+=.14;}return rz;}


float spectrum_fn(vec2 r,float x) {
  
  ivec2 s = textureSize(iChannel0, 0);
    f = max(0., texelFetch(iChannel0,
    ivec2(int(x * float(s.x)), int(0.25 * float(s.y))), 0).x - .3);
    //f=max(0.,textureLod(iChannel0,vec2(x,.25),0.).x-.3);
  f*=f;
  f*=12.;
  
  return f/(x*.5);
}

float bass_thump(vec2 r) {
    float 
      e = 0.
    ;
    e += spectrum_fn(r, 0.02);
    e += spectrum_fn(r, 0.03);
    e += spectrum_fn(r, 0.04);
    e += spectrum_fn(r, 0.05);
    f>0.1?e/=f*1.6:e/=.1;
    //e/=f*1.6;
    return e / 16.;
}

// float spectrum_fn(vec2 r,float x){return texelFetch(iChannel0,ivec2(x*r.x,0.),0).x;}
//float bass_thump(vec2 r){return texelFetch(iChannel0,ivec2(0.,2.),0).x;}
vec3 tanh_approx(vec3 x){vec3 x2=x*x;return clamp(x*(27.+x2)/(27.+9.*x2),-1.,1.);}

float ray_cylinder(vec3 ro,vec3 rd,float r){float a=dot(rd.xy,rd.xy),b=dot(ro.xy,rd.xy);float c=dot(ro.xy,ro.xy)-r*r,h=b*b-a*c;if(h<0.)return-1.;return(-b+sqrt(h))/a;}
float atan_approx(float y,float x){float cosatan2=x/(abs(x)+abs(y));float t=PI_2-cosatan2*PI_2;return y<0.?-t:t;}
vec2 mod_polar(inout vec2 p,float repetitions){float angle=TAU/repetitions;float a=atan_approx(p.y,p.x)+angle/2.;float r=length(p),c=floor(a/angle);a=mod(a,angle)-angle/2.;p=vec2(cos(a),sin(a))*r;if(abs(c)>=(repetitions/2.))c=abs(c);return vec2(c,r);}
float segmentz(vec3 p,float hl){p.z=abs(p.z)-hl;float d0=length(p),d1=length(p.xy);return p.z>0.?d0:d1;}

vec3 hyperspace(vec2 r,vec3 RO,vec3 RD,float FO){float H0,H1,REP,ci,d,n1,fo;vec2 N;vec3 o=mix(0e-6,1e-5,bass_thump(r))*(vec3(1,4,16))/(1.+1e-5-(RD.z)+RD.x*RD.x),p,c;vec4 O;mat2 R=ROT(rot_speed*iTime);o=tanh(clamp(o,vec3(0),vec3(.99)));for(float j=2.;j<9.;++j){REP=j*j+3.;ci=ray_cylinder(RO,RD,j);p=ci*RD+RO;p.xy*=R;N=mod_polar(p.xy,REP);H0=hash(.123*vec2(j,N.x));p.z-=speed*iTime*(1.+H0*H0*H0);fo=exp(-2e-3*ci*ci);c=vec3(N.y,0,p.z);c-=vec3(p.xy,floor(p.z+.5));for(float i=-1.;i<=1.;++i){n1=floor(i+p.z+.5);H1=hash(vec2(H0,n1));float h=fract(H1+j*.13);vec3 col=vec3(1);col.r=.8+.6*sin(TAU*h);col.g=.5+.5*sin(TAU*(h-.33));col.b=.2+.3*sin(TAU*(h-.75));O=vec4(col*(1.+sin(PI*H1*2.+vec4(0,1,2,1)-base_color).w),1.);H1=spectrum_boost*spectrum_fn(r,mix(.975,.025,H1));H1=max(H1,.15);d=segmentz(c-vec3(0,0,i),.05+H1*2.);o+=5e-3*H1/max(d,.001+.02*FO)*smoothstep(1.05,.0,pow(d,.0005))*fo*(O.w+.1)*O.xyz;}}return o;}

// ═══ Main ════════════════════════════════════════════════════════════════════
void mainImage(out vec4 O,vec2 C){
    vec2 r=iResolution.xy,q=C/r,p=(2.*q-1.)*r/r.y;
    vec2 t2=sway_speed*iTime*vec2(sqrt(2.),1.);
    vec3 RO=vec3(sway*sin(t2),-sway_dist),LA=vec3(0);
    vec3 Z=normalize(LA-RO),X=normalize(cross(Z,vec3(.2*cos(t2)+vec2(0,1.),0))),Y=cross(X,Z);
    vec3 RD=normalize(2.*Z+p.y*Y-p.x*X);
    mat2 Rm=ROT(rot_speed*iTime);

    O*=0.0;
    // Cylinder hits
    float ringT[7];
    for(int k=0;k<7;k++){ringT[k]=ray_cylinder(RO,RD,float(k)+2.);if(ringT[k]<0.)ringT[k]=1e9;}

    // Fog
    float vis=1.;vec3 fogColorAccum=vec3(0);
    float cylTransmit[7];for(int k=0;k<7;k++)cylTransmit[k]=1.;
    vec3 lines_pre=hyperspace(r,RO,RD,0.);
    float lineBright=length(lines_pre);
    vec3 lineHue=lineBright>.01?lines_pre/lineBright:vec3(0);

    for(float ft=.5;ft<10.;ft+=.4){
        vec3 fp=RO+RD*ft;
        vec3 np=fp*.05+normalize(vec3(.1,0,.7))*iTime*.05;
        float n=triNoise3D(np,.2);
        float d=pow(max(n-.2,0.),1.5)*3.;
        if(d>.001){
            float cloudEdge=smoothstep(.2,.5,n);
            vec3 stepColor=mix(vec3(.271,.063,.176),vec3(.016,.024,.133),cloudEdge);
            stepColor+=lineHue*min(lineBright,.5)*d*.3;
            fogColorAccum+=vis*stepColor*d*.6;
        }
        vis*=pow(1.2,-d*d);
        float prevFt=ft-.4;
        for(int k=0;k<7;k++){if(prevFt<ringT[k]&&ft>=ringT[k])cylTransmit[k]=vis;}
        if(vis<.01)break;
    }

    // Dashes
    vec3 lines=vec3(0);
    lines+=mix(0e-6,1e-5,bass_thump(r))*vec3(1,4,16)/(1.+1e-5-RD.z+RD.x*RD.x);
    lines=tanh(clamp(lines,vec3(0),vec3(.99)));
    for(int k=0;k<7;k++){
        float j=float(k)+2.,ci=ringT[k];if(ci<0.||ci>1e8)continue;
        vec3 hp=ci*RD+RO,pp=hp;pp.xy*=Rm;
        float REP=j*j+3.;vec2 N=mod_polar(pp.xy,REP);
        float H0=hash(.123*vec2(j,N.x));pp.z-=speed*iTime*(1.+H0*H0*H0);
        float fo=exp(-2e-3*ci*ci);vec3 c=vec3(N.y,0,pp.z);c-=vec3(pp.xy,floor(pp.z+.5));
        for(float i=-1.;i<=1.;++i){
            float n1=floor(i+pp.z+.5),H1=hash(vec2(H0,n1));
            float h=fract(H1+j*.13);vec3 col=vec3(1);
            col.r=.8+.6*sin(TAU*h);col.g=.5+.5*sin(TAU*(h-.33));col.b=.2+.3*sin(TAU*(h-.75));
            vec4 O2=vec4(col*(1.+sin(PI*H1*2.+vec4(0,1,2,1)-base_color).w),1.);
            H1=spectrum_boost*spectrum_fn(r,mix(.975,.025,H1));H1=max(H1,.15);
            float d=segmentz(c-vec3(0,0,i),.05+H1*2.);
            lines+=5e-3*H1/max(d,.001)*smoothstep(1.05,.0,pow(d,.0005))*fo*(O2.w+.1)*O2.xyz*cylTransmit[k];
        }
    }

    // Composite fog + dashes
    float fog=1.-vis;
    vec3 fogFinal=fogColorAccum/max(fog,.001);
    float fogLum=dot(fogFinal,vec3(.299,.587,.114));
    fogFinal=mix(fogFinal,vec3(fogLum),.3);
    vec3 col=mix(lines,fogFinal,clamp(fog*.6,0.,.5));

    // Post
    col-=3e-2*vec3(3,2,1)*length(p+.25);
    col=max(col,0.);col=tanh_approx(1.125*col);col=sqrt(col)-.05;

    // ═══ Text overlay sequence (plays once) ══════════════════════════════
    float T=iTime;
   // ═══ Text overlay sequence (resets on recompile) ═════════════════════
    float introT = float(iFrame) / 60.;  // frame-based, resets to 0
    if(introT < INTRO_END){
        vec4 txt=vec4(0);

        if(introT < PHASE1_DUR+1.){
            float fadeIn=smoothstep(0.,.5,introT);
            float fadeOut=smoothstep(PHASE1_DUR+.5,PHASE1_DUR-.5,introT);
            txt=renderSpell(C,r,introT,0);
            txt.a*=fadeIn*fadeOut;
        }
        else if(introT>=PHASE2_START&&introT<PHASE2_START+PHASE2_DUR+1.){
            float localT=introT-PHASE2_START;
            float fadeIn=smoothstep(0.,.5,localT);
            float fadeOut=smoothstep(PHASE2_DUR+.5,PHASE2_DUR-.5,localT);
            txt=renderVoodoo(C,r);
            txt.a*=fadeIn*fadeOut;
        }

        col=mix(col,txt.rgb,txt.a);
    }

    O=vec4(col,1.);
}
